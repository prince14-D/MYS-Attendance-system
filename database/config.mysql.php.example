<?php
declare(strict_types=1);

/*
 * Copy this file to config.mysql.php, then enter your MySQL credentials.
 * Keep config.mysql.php private: do not commit it to Git.
 */
const MYSQL_HOST = '127.0.0.1';
const MYSQL_PORT = '3306';
const MYSQL_DATABASE = 'mys_attendance';
const MYSQL_USERNAME = 'mys_attendance_user';
const MYSQL_PASSWORD = 'replace-with-a-strong-password';

function mysql_connection(): PDO
{
    static $connection = null;

    if ($connection instanceof PDO) {
        return $connection;
    }

    $connection = new PDO(
        'mysql:host=' . MYSQL_HOST . ';port=' . MYSQL_PORT . ';dbname=' . MYSQL_DATABASE . ';charset=utf8mb4',
        MYSQL_USERNAME,
        MYSQL_PASSWORD,
        [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            PDO::ATTR_EMULATE_PREPARES => false,
        ]
    );

    return $connection;
}
